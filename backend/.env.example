# Copy to .env and adjust as needed. Every value has a sane default, so .env is
# optional for local development.

# SQLAlchemy database URL.
#   dev  : sqlite:///./sat_studypath.db
#   prod : postgresql+psycopg://user:pass@host:5432/sat_studypath
DATABASE_URL=sqlite:///./sat_studypath.db

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Guards POST /api/topics/seed, which wipes and regenerates the caller's data.
# Leave true for local dev; set false in any shared deployment.
ENABLE_DEV_ENDPOINTS=true

# Auth. MUST be a long random string in any deployment (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-do-not-use-in-production
JWT_EXPIRE_MINUTES=10080
