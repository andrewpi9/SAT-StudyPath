# Copy to .env and adjust as needed. All values have sane defaults, so .env is optional for local dev.

# SQLAlchemy database URL.
#   dev  : sqlite:///./sat_studypath.db
#   prod : postgresql+psycopg://user:pass@host:5432/sat_studypath
DATABASE_URL=sqlite:///./sat_studypath.db

# Comma-separated list of origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
